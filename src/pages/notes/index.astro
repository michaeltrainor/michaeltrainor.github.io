---
import NoteList from '../../components/NoteList.astro';
import Base from '../../layouts/Base.astro';
import { getNotes } from '../../lib/data';

const notes = await getNotes();
---

<Base title="Notes" description="Writing on pipelines, tools, and rendering.">
  <section class="section container">
    <p class="eyebrow">Notes</p>
    <h1>Notes</h1>
    <p class="muted" style="max-width:60ch;margin-bottom:32px">Writing on pipelines, tools, rendering, and whatever I'm learning. <a href="/rss.xml">Subscribe via RSS</a>.</p>
    <NoteList notes={notes} />
  </section>
</Base>
