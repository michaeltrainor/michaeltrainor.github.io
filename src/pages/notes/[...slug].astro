---
import { render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getNotes, isoDate } from '../../lib/data';

export async function getStaticPaths() {
  const notes = await getNotes();
  return notes.map((note) => ({ params: { slug: note.id }, props: note }));
}

type Props = CollectionEntry<'notes'>;
const note = Astro.props;
const { Content } = await render(note);
const { title, description, pubDate, updatedDate, tags } = note.data;
---

<Base title={title} description={description}>
  <article class="section container">
    <p class="eyebrow">notes/{note.id}</p>
    <header>
      <h1>{title}</h1>
      <p class="muted mono meta">
        <time datetime={pubDate.toISOString()}>{isoDate(pubDate)}</time>
        {updatedDate && <> · updated {isoDate(updatedDate)}</>}
      </p>
      {tags.length > 0 && <ul class="tags">{tags.map((t) => <li class="tag">{t}</li>)}</ul>}
    </header>
    <div class="prose"><Content /></div>
    <p class="mono back"><a href="/notes/">&laquo; back to notes</a></p>
  </article>
</Base>

<style>
  header { margin-bottom: 20px; padding-bottom: 10px; border-bottom: 1px dashed var(--border); }
  h1 { margin-bottom: 0.2em; }
  .meta { font-size: 0.85rem; margin-bottom: 4px; }
  .back { margin-top: 24px; font-size: 0.85rem; }
</style>
