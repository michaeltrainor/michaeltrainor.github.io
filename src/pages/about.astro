---
import { getCollection } from 'astro:content';
import { SITE, SOCIALS } from '../consts';
import Base from '../layouts/Base.astro';

const skills = await getCollection('skills');
const experience = await getCollection('experience');
---

<Base title="About" description={`About ${SITE.title}.`}>
  <section class="section container">
    <p class="eyebrow">About</p>
    <h1>About</h1>
    <div class="prose lede">
      <p>
        I'm a Python developer and 3D pipeline specialist with a background as a technical artist and animation TD
        in games and feature film VFX.
      </p>
      <p>
        I build scalable systems for digital content creation: DCC tool integration, asset management, and the
        backend services that keep production pipelines moving. I'm currently open to contract work.
      </p>
      <p>Find me on {SOCIALS.map((s, i) => <>{i > 0 && (i === SOCIALS.length - 1 ? ', or ' : ', ')}<a href={s.href} target="_blank" rel="me noopener">{s.label}</a></>)}.</p>
    </div>
  </section>

  <section class="section container">
    <h2>Toolbox</h2>
    <div class="grid">
      {skills.map((g) => (
        <div class="card">
          <h3>{g.data.title}</h3>
          <ul class="tags">{g.data.items.map((i) => <li class="tag">{i}</li>)}</ul>
        </div>
      ))}
    </div>
  </section>

  <section class="section container">
    <h2>Experience</h2>
    <ol class="timeline">
      {experience.map((e) => (
        <li>
          <span class="mono muted period">{e.data.period}</span>
          <div>
            <h3>{e.data.role}</h3>
            <p class="muted org">{e.data.org}</p>
            <p>{e.data.summary}</p>
          </div>
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .lede { font-size: 1.1rem; }
  .card .tags { gap: 8px; }
  .timeline { list-style: none; margin: 0; padding: 0; border-left: 2px solid var(--border); }
  .timeline li { position: relative; display: grid; grid-template-columns: 7rem 1fr; gap: 20px; padding: 0 0 32px 24px; }
  .timeline li::before { content: ''; position: absolute; left: -7px; top: 6px; width: 12px; height: 12px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px var(--bg); }
  .period { font-size: 0.85rem; padding-top: 2px; }
  .org { margin: -0.3em 0 0.5em; }
  @media (max-width: 560px) { .timeline li { grid-template-columns: 1fr; gap: 4px; } }
</style>
