---
import NoteList from '../components/NoteList.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { SITE } from '../consts';
import Base from '../layouts/Base.astro';
import { getNotes, getProjects, getRecentRepos, isoDate } from '../lib/data';

const featured = (await getProjects()).filter((p) => p.data.featured);
const notes = (await getNotes()).slice(0, 5);
const activity = await getRecentRepos(5);
---

<Base>
  <section class="section container intro">
    <h1>{SITE.title}</h1>
    <p class="mono muted role">{SITE.role}</p>
    <p>
      Python developer and 3D pipeline specialist with a background in games and feature film VFX
      (technical artist, animation TD). I build pipelines, DCC tools, and asset systems that help studios ship faster.
    </p>
    {SITE.available && <p class="mono status">status: <span class="ok">available for contract work</span></p>}
  </section>

  <section class="section container">
    <div class="section-head">
      <h2>Projects</h2>
      <a href="/projects/">all projects &raquo;</a>
    </div>
    <div class="grid">{featured.map((p) => <ProjectCard project={p} />)}</div>
  </section>

  <section class="section container split">
    <div>
      <div class="section-head">
        <h2>Notes</h2>
        <a href="/notes/">all notes &raquo;</a>
      </div>
      <NoteList notes={notes} />
    </div>
    <div>
      <div class="section-head"><h2>Recent pushes</h2></div>
      {activity.length === 0 ? (
        <p class="muted">GitHub activity is unavailable right now.</p>
      ) : (
        <table class="activity mono">
          <tbody>
            {activity.map((r) => (
              <tr>
                <td><a href={r.url} target="_blank" rel="noopener">{r.name}</a></td>
                <td class="muted">{isoDate(r.pushedAt)}</td>
              </tr>
            ))}
          </tbody>
        </table>
      )}
    </div>
  </section>
</Base>

<style>
  .intro { padding-top: 32px; }
  .intro h1 { margin-bottom: 0; }
  .role { margin-bottom: 1.2em; }
  .intro p { max-width: 72ch; }
  .ok { color: var(--ok); }
  .split { display: grid; grid-template-columns: 3fr 2fr; gap: 32px; }
  .activity { width: 100%; border-collapse: collapse; font-size: 0.85rem; }
  .activity td { padding: 3px 0; border-bottom: 1px dotted var(--border); }
  .activity td:last-child { text-align: right; }
  @media (max-width: 720px) { .split { grid-template-columns: 1fr; gap: 0; } }
</style>
