---
import type { CollectionEntry } from 'astro:content';
import { fmtDate } from '../lib/data';

interface Props { notes: CollectionEntry<'notes'>[] }

const { notes } = Astro.props;
---

{notes.length === 0 ? (
  <p class="muted">No notes yet.</p>
) : (
  <ul class="notes">
    {notes.map((n) => (
      <li>
        <a href={`/notes/${n.id}/`}>
          <time class="mono muted" datetime={n.data.pubDate.toISOString()}>{fmtDate(n.data.pubDate)}</time>
          <span class="title" transition:name={`note-${n.id}`}>{n.data.title}</span>
          <span class="muted desc">{n.data.description}</span>
        </a>
      </li>
    ))}
  </ul>
)}

<style>
  .notes { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--border); }
  li { border-bottom: 1px solid var(--border); }
  a { display: grid; grid-template-columns: 9rem 1fr; gap: 4px 20px; padding: 18px 4px; color: var(--text); }
  a:hover { text-decoration: none; background: var(--accent-soft); }
  time { font-size: 0.82rem; padding-top: 2px; }
  .title { font-weight: 650; }
  .desc { grid-column: 2; font-size: 0.93rem; }
  @media (max-width: 560px) {
    a { grid-template-columns: 1fr; }
    .desc { grid-column: 1; }
  }
</style>
