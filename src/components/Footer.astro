---
import { SITE, SOCIALS } from '../consts';

const built = new Date();
---

<footer class="site-footer">
  <div class="container">
    <hr />
    <p>
      {SOCIALS.map((s) => <><a href={s.href} rel="me noopener" target="_blank">{s.label.toLowerCase()}</a> | </>)}
      <a href="/rss.xml">rss</a>
    </p>
    <p class="muted">
      © {built.getFullYear()} {SITE.title}. Last built {built.toISOString().slice(0, 10)}.
      Built with <a href="https://astro.build">Astro</a>, colors by <a href="https://www.nordtheme.com/">Nord</a>.
    </p>
  </div>
</footer>

<style>
  .site-footer { padding: 8px 0 24px; font-family: var(--font-mono); font-size: 0.8rem; }
  hr { border: 0; border-top: 1px solid var(--border); margin: 0 0 12px; }
  p { margin: 0 0 4px; }
</style>
