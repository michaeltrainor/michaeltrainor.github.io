---
import { NAV, SITE } from '../consts';

const path = Astro.url.pathname;
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="site-header" transition:persist>
  <div class="container bar">
    <a href="/" class="brand" aria-label={`${SITE.title}, home`}>{SITE.handle}@michaeltrainor.com:~$</a>
    <nav aria-label="Main">
      {NAV.map((item) => (
        <a href={item.href} class:list={{ active: isActive(item.href) }} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label.toLowerCase()}
        </a>
      ))}
      <button class="theme-toggle" type="button" aria-label="Toggle color theme">theme</button>
    </nav>
  </div>
</header>

<script>
  // The header persists across navigations, so update the active link by hand.
  const syncActive = () => {
    const path = location.pathname;
    document.querySelectorAll<HTMLAnchorElement>('.site-header nav a').forEach((a) => {
      const href = a.getAttribute('href')!;
      const on = href === '/' ? path === '/' : path.startsWith(href);
      a.classList.toggle('active', on);
      if (on) a.setAttribute('aria-current', 'page');
      else a.removeAttribute('aria-current');
    });
  };
  document.addEventListener('astro:page-load', syncActive);

  document.querySelector('.theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try { localStorage.setItem('theme', next); } catch {}
  });
</script>

<style>
  .site-header { background: var(--nord1); border-bottom: 3px solid var(--nord10); font-family: var(--font-mono); }
  .bar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 4px 16px; padding-top: 8px; padding-bottom: 8px; }
  .brand, .brand:visited { color: var(--nord14); font-weight: bold; text-decoration: none; }
  .brand:hover { color: var(--nord13); }
  nav { display: flex; flex-wrap: wrap; gap: 2px 12px; font-size: 0.9rem; }
  nav a, nav a:visited, .theme-toggle { color: var(--nord4); text-decoration: none; }
  nav a::before, .theme-toggle::before { content: '['; color: var(--nord3); }
  nav a::after, .theme-toggle::after { content: ']'; color: var(--nord3); }
  nav a:hover, .theme-toggle:hover { color: var(--nord8); }
  nav a.active { color: var(--nord8); font-weight: bold; }
  .theme-toggle { font: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
</style>
