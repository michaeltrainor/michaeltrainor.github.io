---
import { timeAgo, type ProjectWithRepo } from '../lib/data';

interface Props { project: ProjectWithRepo }

const { project } = Astro.props;
const { title, summary, tags, url } = project.data;
const repo = project.repo;
const href = url ?? repo?.url;
---

<div class="card project" data-tags={tags.join('|')}>
  <h3 class="mono">{href ? <a href={href} target="_blank" rel="noopener">{title}</a> : title}</h3>
  <p>{summary}</p>
  <ul class="tags">{tags.map((t) => <li class="tag">{t.toLowerCase()}</li>)}</ul>
  {repo && (
    <p class="meta mono muted">
      {repo.language && <>lang: {repo.language} · </>}stars: {repo.stars} · last push: {timeAgo(repo.pushedAt)}
    </p>
  )}
</div>

<style>
  h3 { margin: 0; }
  p { margin: 0; flex: 1; }
  .meta { flex: none; font-size: 0.78rem; padding-top: 6px; border-top: 1px dotted var(--border); }
</style>
